# Set these in Netlify: Site configuration → Environment variables. Never commit real values.
PCO_APP_ID=
PCO_SECRET=
# Note category for MySteps answers (create a "MySteps" category, or use "General"; the ID is in its URL)
PCO_NOTE_CATEGORY_ID=
# Optional: workflow for people who answer "Yes" to follow-up (create a "MySteps Follow-Up" workflow)
PCO_WORKFLOW_ID=
# Optional: only if MySteps is embedded on a different domain than it's hosted on
ALLOWED_ORIGIN=
