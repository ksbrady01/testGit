# Public site URL (canonical URLs, Open Graph). Vite exposes VITE_* variables to the browser.
VITE_SITE_URL=https://www.wearechmedia.com

# ---- Form delivery (server-only; configure at least one in production) ----
# In AI Studio, add these as project Secrets rather than committing them.

# Option A: email via Resend (https://resend.com). Sender domain must be verified in Resend.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=hello@chmedia.com
INQUIRY_FROM_EMAIL=CleverHouse Website <website@wearechmedia.com>

# Option B: POST each submission as JSON to a webhook (GoHighLevel inbound webhook, Zapier, Make, n8n...)
INQUIRY_WEBHOOK_URL=

# In development with neither configured, submissions are saved to .data/inquiries.jsonl
