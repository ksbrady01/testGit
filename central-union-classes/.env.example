# Copy to .env (or add as AI Studio environment variables). All are optional.

# Emails that can edit or delete any class and see the Learners page (comma-separated).
VITE_ADMIN_EMAILS=

# Public URL of the app, used in "Share class" links. Defaults to the current page.
VITE_APP_URL=

# GoHighLevel Inbound Webhook URL. When set, learner progress is sent here so a
# workflow can create/update the contact and send reminder emails or texts.
VITE_GHL_WEBHOOK_URL=
