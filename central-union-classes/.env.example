# Copy to .env for local development, or add in AI Studio.

# --- Public settings (AI Studio environment variables) ---
# Emails that can edit or delete any class and see the Learners page (comma-separated).
VITE_ADMIN_EMAILS=
# Public URL of the app, used in "Share class" links. Defaults to the current site.
VITE_APP_URL=

# --- Server secret (AI Studio Secrets) ---
# GoHighLevel Inbound Webhook URL. Learner progress is sent here so a workflow
# can create/update the contact and send reminder emails or texts.
GHL_REMINDER_WEBHOOK_URL=
